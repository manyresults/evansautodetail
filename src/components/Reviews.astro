---
/**
 * Reviews.astro
 * If REVIEWS (consts.ts) has entries, they render as quote cards. Until real
 * customer quotes are supplied, the section shows a strong satisfaction /
 * "leave us a review" panel instead of any fabricated testimonials.
 *
 * The reviews are Facebook "recommendations" (not star ratings), so each card
 * shows a "Recommends on Facebook" badge rather than a star count.
 */
import { REVIEWS, SITE } from "../consts";
const hasReviews = REVIEWS.length > 0;
---

<section id="reviews" class="bg-ink-900 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Reviews</p>
      <h2 class="mt-4 text-3xl font-bold uppercase text-white sm:text-5xl">
        What customers <span class="text-red">say</span>
      </h2>
      <p class="mt-4 text-lg text-white/70">
        Real recommendations from real customers on Facebook.
      </p>
    </div>

    {hasReviews ? (
      <>
        <div class="mt-12 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {REVIEWS.map((r) => (
            <figure class="flex h-full flex-col rounded-md border border-line bg-ink-800 p-7">
              <div class="inline-flex items-center gap-2 text-sm font-medium text-red">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 10v10H4a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h3Zm3 0 3.2-6.4A1.6 1.6 0 0 1 16 4.6V8h4a1.6 1.6 0 0 1 1.6 1.9l-1.3 8A2 2 0 0 1 18.3 20H10V10Z"/></svg>
                Recommends on Facebook
              </div>
              <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-white/85">"{r.quote}"</blockquote>
              <figcaption class="mt-5 border-t border-line pt-4 text-sm">
                <span class="font-semibold text-white">{r.author}</span>
                {r.source && <span class="text-white/50"> · {r.source}</span>}
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="mt-10 flex flex-col items-start gap-4 rounded-md border border-line bg-ink-800 p-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-display text-lg font-medium uppercase tracking-wide text-white">
            Had your vehicle detailed by us? <span class="text-red">We'd love a review.</span>
          </p>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-primary shrink-0">Review us on Facebook</a>
        </div>
      </>
    ) : (
      <div class="mt-12 overflow-hidden rounded-md border border-line bg-ink-800">
        <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.3fr_1fr] lg:items-center">
          <div>
            <div class="text-2xl text-red" aria-hidden="true">★★★★★</div>
            <p class="mt-5 font-display text-2xl font-bold uppercase leading-tight text-white sm:text-3xl">
              {SITE.guarantee}
            </p>
            <p class="mt-4 text-lg text-white/70">
              We've earned the trust of drivers across {SITE.region} since {SITE.since}
              by letting our work speak for itself — and standing behind every job, no
              exceptions. Had your vehicle detailed by us? We'd love to hear how it went.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Review us on Facebook</a>
            <a href={SITE.smsHref} class="btn btn-ghost">Text {SITE.phoneDisplay}</a>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
