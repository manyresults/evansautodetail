---
/**
 * Reviews.astro
 * If REVIEWS (consts.ts) has entries, they render as quote cards. Until real
 * customer quotes are supplied, the section shows a strong satisfaction /
 * "leave us a review" panel instead of any fabricated testimonials.
 */
import { REVIEWS, SITE } from "../consts";
const hasReviews = REVIEWS.length > 0;
---

<section id="reviews" class="bg-ink-900 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Reviews</p>
      <h2 class="mt-4 text-3xl font-bold uppercase text-white sm:text-5xl">
        What customers <span class="text-red">say</span>
      </h2>
    </div>

    {hasReviews ? (
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {REVIEWS.map((r) => (
          <figure class="flex h-full flex-col rounded-md border border-line bg-ink-800 p-7">
            <div class="text-red" aria-hidden="true">★★★★★</div>
            <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-white/80">"{r.quote}"</blockquote>
            <figcaption class="mt-5 border-t border-line pt-4 text-sm">
              <span class="font-semibold text-white">{r.author}</span>
              {r.source && <span class="text-white/50"> · {r.source}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="mt-12 overflow-hidden rounded-md border border-line bg-ink-800">
        <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.3fr_1fr] lg:items-center">
          <div>
            <div class="text-2xl text-red" aria-hidden="true">★★★★★</div>
            <p class="mt-5 font-display text-2xl font-bold uppercase leading-tight text-white sm:text-3xl">
              {SITE.guarantee}
            </p>
            <p class="mt-4 text-lg text-white/70">
              We've earned the trust of drivers across {SITE.region} since {SITE.since}
              by letting our work speak for itself — and standing
              behind every job, no exceptions. Had your vehicle detailed by us?
              We'd love to hear how it went.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Review us on Facebook</a>
            <a href={SITE.smsHref} class="btn btn-ghost">Text {SITE.phoneDisplay}</a>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
