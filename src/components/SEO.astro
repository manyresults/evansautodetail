---
/**
 * SEO.astro — imported once via BaseLayout.
 * Handles: <title> + meta description, Open Graph + Twitter cards, canonical
 * URL, and JSON-LD LocalBusiness (AutoWash) schema for a mobile /
 * service-area auto detailing business (no public street address).
 */
import { SITE, SERVICE_AREAS, SERVICES } from "../consts";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  canonical,
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// --- JSON-LD: LocalBusiness / AutoWash (service-area business) ---------------
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoWash",
  "@id": `${SITE.url}/#business`,
  name: SITE.name,
  legalName: SITE.legalName,
  description: SITE.description,
  slogan: SITE.tagline,
  url: SITE.url,
  telephone: SITE.phoneDisplay,
  image: imageURL.href,
  logo: imageURL.href,
  priceRange: "$$",
  foundingDate: String(SITE.since),
  founder: { "@type": "Person", name: SITE.owner },
  // Mobile business: locality/region only, no street address published.
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.city,
    addressRegion: SITE.state,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  areaServed: SERVICE_AREAS.map((a) => ({ "@type": "Place", name: `${a}, PA` })),
  serviceArea: {
    "@type": "GeoCircle",
    geoMidpoint: {
      "@type": "GeoCoordinates",
      latitude: SITE.geo.lat,
      longitude: SITE.geo.lng,
    },
    geoRadius: "24140", // ~15 miles, in meters
  },
  makesOffer: SERVICES.map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.title, description: s.summary },
  })),
  ...(SITE.social.facebook ? { sameAs: [SITE.social.facebook] } : {}),
};
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#0f0f0f" />
<meta name="author" content={SITE.owner} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
