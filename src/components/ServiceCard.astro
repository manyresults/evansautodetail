---
import ServiceIcon from "./ServiceIcon.astro";
import type { Service } from "../consts";
interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<article class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-accent/40 hover:shadow-md">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-white">
    <ServiceIcon name={service.icon} />
  </div>
  <h3 class="mt-4 text-lg font-bold text-ink">{service.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{service.summary}</p>
  {
    service.price && (
      <p class="mt-4 inline-flex w-fit rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-amber-700">
        {service.price}
      </p>
    )
  }
</article>
