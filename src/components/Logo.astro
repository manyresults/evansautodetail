---
/**
 * Logo.astro — the Evans' Detailing wordmark (red/white car + text), optimized
 * via astro:assets. Designed for dark backgrounds (the whole site is dark).
 */
import { Image } from "astro:assets";
import logo from "../assets/logo-evans-dark.png";
import { SITE } from "../consts";

interface Props {
  class?: string;
}
const { class: className = "h-11 w-auto" } = Astro.props;
---

<Image
  src={logo}
  alt={`${SITE.name} — ${SITE.tagline}`}
  class={className}
  width={520}
  densities={[1, 2]}
  loading="eager"
/>
