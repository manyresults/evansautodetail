---
/**
 * Hero.astro — bold, high-contrast opening section.
 * Real work photo (glossy black detail) behind a heavy dark/red overlay, with
 * a punchy headline and a text-to-book CTA (the primary action everywhere).
 */
import { Image } from "astro:assets";
import { SITE } from "../consts";
import heroImg from "../assets/gallery/evans-detail-black-kia.jpg";
---

<section id="hero" class="relative isolate flex min-h-[92vh] items-center overflow-hidden bg-ink-950">
  <!-- Background photo -->
  <Image
    src={heroImg}
    alt="A freshly detailed black SUV with a deep mirror shine"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    widths={[640, 960]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Overlays: darken + red edge glow -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/85 to-ink-950/40"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-transparent to-ink-950/60"></div>
  <div class="absolute inset-y-0 left-0 -z-10 w-1.5 bg-red"></div>

  <div class="mx-auto w-full max-w-7xl px-4 py-28 sm:px-6">
    <div class="max-w-2xl rise">
      <p class="eyebrow">Mobile Auto Detailing · {SITE.city}, {SITE.state}</p>

      <h1 class="mt-5 text-4xl font-bold uppercase leading-[0.98] text-white sm:text-6xl lg:text-7xl">
        Showroom shine,<br />
        <span class="text-red">delivered</span> to your driveway.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
        Evans' Detailing is {SITE.region}'s mobile car wash &amp; detailing
        service. Full interior and exterior detailing, ceramic coatings, wax and
        polish — we come to you. Detailing since {SITE.since}.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={SITE.smsHref} class="btn btn-primary text-base">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16v11H8l-4 4V5Z"/></svg>
          Text {SITE.phoneDisplay}
        </a>
        <a href="#gallery" class="btn btn-ghost text-base">See our work</a>
      </div>

      <ul class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-white/70">
        <li class="flex items-center gap-2"><span class="text-red">★</span> {SITE.yearsExperience} years experience</li>
        <li class="flex items-center gap-2"><span class="text-red">★</span> 100% satisfaction guarantee</li>
        <li class="flex items-center gap-2"><span class="text-red">★</span> Cars · Trucks · Boats · Bikes</li>
      </ul>
    </div>
  </div>

  <!-- Scroll cue -->
  <a href="#services" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/50 transition-colors hover:text-red" aria-label="Scroll to services">
    <svg class="h-7 w-7 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
  </a>
</section>
