---
import { SITE } from "../consts";
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  showBadges?: boolean;
}
const { title, subtitle, eyebrow, showBadges = false } = Astro.props;
---

<section class="relative overflow-hidden bg-ink">
  <!-- decorative accent glow -->
  <div
    class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-accent/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-accent/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-3xl">
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-wider text-accent">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      {subtitle && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">{subtitle}</p>}

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={SITE.phoneHref}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-base font-semibold text-white shadow-lg transition-colors hover:bg-accent-600"
        >
          Call {SITE.phoneDisplay}
        </a>
        <a
          href="/services/"
          class="inline-flex items-center gap-2 rounded-full border border-white/25 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-white/10"
        >
          View services
        </a>
      </div>

      {
        showBadges && (
          <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8">
            <div>
              <dt class="text-2xl font-extrabold text-white">{SITE.yearsExperience}</dt>
              <dd class="mt-1 text-xs text-slate-400">Years of experience</dd>
            </div>
            <div>
              <dt class="text-2xl font-extrabold text-white">4×</dt>
              <dd class="mt-1 text-xs text-slate-400">Best of Bucks winner</dd>
            </div>
            <div>
              <dt class="text-2xl font-extrabold text-white">5.0★</dt>
              <dd class="mt-1 text-xs text-slate-400">Customer rating</dd>
            </div>
          </dl>
        )
      }
    </div>
  </div>
</section>
