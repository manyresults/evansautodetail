---
import { TESTIMONIALS } from "../consts";
interface Props {
  heading?: string;
}
const { heading = "What our customers say" } = Astro.props;
---

<section class="bg-slate-50 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Reviews</p>
      <h2 class="mt-2 text-3xl font-extrabold text-ink sm:text-4xl">{heading}</h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        TESTIMONIALS.map((t) => (
          <figure class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex gap-0.5 text-gold" aria-label="5 out of 5 stars">
              {[0, 1, 2, 3, 4].map(() => (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9L10 1.5Z" />
                </svg>
              ))}
            </div>
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-slate-700">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-ink">
              {t.author}
              {t.source && <span class="block text-xs font-normal text-slate-500">{t.source}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
