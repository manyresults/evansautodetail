---
/**
 * ServiceIcon.astro — maps a `name` key (from SERVICES[].icon) to an inline
 * SVG. Inline SVGs keep the site fast (no image requests) and crisp at any size.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "h-7 w-7" } = Astro.props;
---

<svg
  class={className}
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.6"
  stroke="currentColor"
  aria-hidden="true"
>
  {name === "sparkle" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.8 4.2 11 8l3.8 1.2L11 10.4 9.8 14 8.6 10.4 4.8 9.2 8.6 8 9.8 4.2Zm7.7 8 .8 2.5 2.5.8-2.5.8-.8 2.5-.8-2.5-2.5-.8 2.5-.8.8-2.5Z" />
  )}
  {name === "shield" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 2.5v5c0 4.6-3 8.4-7 9.5-4-1.1-7-4.9-7-9.5v-5L12 3Zm-2.5 8.5 2 2 3.5-4" />
  )}
  {name === "polish" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 20 14 10m0 0 2.5-2.5a2.1 2.1 0 0 1 3 3L17 13m-3-3 3 3m1-9 .6 1.6L20 6l-1.4.4L18 8l-.6-1.6L16 6l1.4-.4L18 4Z" />
  )}
  {name === "film" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Zm0 4h16M9 4v16" />
  )}
  {name === "dent" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 0 1 18 0 9 9 0 0 1-18 0Zm5.5 1.5c1-2 2-3 3.5-3s2.5 1 3.5 3" />
  )}
  {name === "windshield" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 16c1.5-6 3-8 7-8s5.5 2 7 8c-4-1.2-10-1.2-14 0Zm7-8v8" />
  )}
  {name === "truck" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v8H3V7Zm11 3h3.5L20 12.5V15h-6v-5ZM7 18a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
  )}
  {name === "van" && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8a1 1 0 0 1 1-1h9.5c.6 0 1.2.3 1.6.8L19 12l1.5.5c.3.1.5.4.5.8V15h-2M3 8v7h2m0 0a1.5 1.5 0 0 0 3 0m-3 0h3m8 0a1.5 1.5 0 0 0 3 0m-3 0h3M8 15h6M13 7v5h6" />
  )}
</svg>
