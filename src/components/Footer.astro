---
/**
 * Footer.astro — logo, quick anchor links, contact, and copyright.
 */
import { NAV, SITE } from "../consts";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <div class="max-w-sm">
        <a href="#top" aria-label={`${SITE.name} — home`}><Logo class="h-11 w-auto" /></a>
        <p class="mt-4 text-sm leading-relaxed text-white/60">
          {SITE.legalName} — {SITE.tagline.toLowerCase()} in {SITE.city}, {SITE.state},
          serving {SITE.region}. Detailing since {SITE.since}.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white">Explore</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {NAV.map((item) => (
              <li><a href={item.href} class="text-white/60 transition-colors hover:text-red">{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white">Contact</h3>
          <ul class="mt-4 space-y-2.5 text-sm text-white/60">
            <li><a href={SITE.smsHref} class="transition-colors hover:text-red">Text {SITE.phoneDisplay}</a></li>
            <li><a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-red">Facebook</a></li>
            <li>{SITE.hours} · Mobile service</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white">Book now</h3>
          <a href={SITE.smsHref} class="btn btn-primary mt-4 w-full text-sm">Text to book</a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>Mobile auto detailing · {SITE.region}, PA</p>
    </div>
  </div>
</footer>
