---
import { SITE, NAV } from "../consts";
const year = new Date().getFullYear();
const openDays = SITE.hours.filter((h) => h.open && h.close);
---

<footer class="bg-ink text-slate-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <!-- Brand + blurb -->
    <div class="md:col-span-2">
      <p class="font-display text-xl font-extrabold text-white">
        Earl's <span class="text-accent">Proper</span> Detailing
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-400">
        {SITE.tagline} Expert auto detailing, ceramic coating, and paint
        protection in {SITE.address.city}, {SITE.address.state}.
      </p>
      {
        SITE.social.facebook && (
          <a
            href={SITE.social.facebook}
            class="mt-4 inline-flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-accent"
            rel="noopener"
            target="_blank"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
            </svg>
            Follow us on Facebook
          </a>
        )
      }
    </div>

    <!-- Nav -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-slate-400 transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Visit / Call</h2>
      <address class="mt-4 space-y-2 text-sm not-italic text-slate-400">
        <p>
          <a href={SITE.mapsUrl} class="transition-colors hover:text-accent" target="_blank" rel="noopener">
            {SITE.address.street}<br />
            {SITE.address.city}, {SITE.address.state} {SITE.address.zip}
          </a>
        </p>
        <p>
          <a href={SITE.phoneHref} class="transition-colors hover:text-accent">{SITE.phoneDisplay}</a>
        </p>
        <p>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-accent">{SITE.email}</a>
        </p>
      </address>
      {
        openDays.length > 0 && (
          <p class="mt-3 text-xs text-slate-500">
            {openDays[0].day}–{openDays[openDays.length - 1].day}: {openDays[0].open}–{openDays[0].close}
          </p>
        )
      }
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:px-6">
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <p>{SITE.awards} · {SITE.yearsExperience} years serving Bucks County</p>
    </div>
  </div>
</footer>
