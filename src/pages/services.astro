---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import CTA from "../components/CTA.astro";
import { SITE, SERVICES } from "../consts";
---

<BaseLayout
  title="Auto Detailing Services"
  description={`Explore Earl's Proper Detailing services in ${SITE.address.city}, ${SITE.address.state}: full auto detailing, ceramic coating, paint correction, paint protection film, dent repair, windshield service, and more.`}
>
  <Hero
    eyebrow="Our services"
    title="Everything your vehicle needs to look its best"
    subtitle="From a full interior-and-exterior detail to long-lasting ceramic coating and paint protection, we do it all — with the care and craftsmanship that's earned us four Best of Bucks awards."
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <ul class="space-y-6">
        {
          SERVICES.map((service) => (
            <li
              id={service.slug}
              class="flex flex-col gap-5 rounded-2xl border border-slate-200 p-6 sm:flex-row sm:p-8"
            >
              <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                <ServiceIcon name={service.icon} class="h-8 w-8" />
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-xl font-bold text-ink">{service.title}</h2>
                  {service.price && (
                    <span class="rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-amber-700">
                      {service.price}
                    </span>
                  )}
                </div>
                <p class="mt-3 leading-relaxed text-slate-600">{service.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">
        Don't see exactly what you need? We handle a wide range of detailing and
        body work — including tire renovator &amp; shine, vinyl dressings, window
        finishes, and custom work. <a href="/contact/" class="font-semibold text-accent hover:text-accent-600">Get in touch</a> and we'll take care of it.
      </p>
    </div>
  </section>

  <CTA heading="Not sure which service you need?" text="Give us a call and we'll recommend the right package for your vehicle and budget." />
</BaseLayout>
