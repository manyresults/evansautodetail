---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
---

<BaseLayout title="Page not found" noindex={true}>
  <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-4 py-28 text-center sm:px-6">
    <p class="font-display text-7xl font-bold text-red">404</p>
    <h1 class="mt-4 text-3xl font-bold uppercase text-white sm:text-4xl">This page took a wrong turn</h1>
    <p class="mt-4 text-lg text-white/70">
      Sorry, we couldn't find that one. Let's get you back on the road.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href={SITE.smsHref} class="btn btn-ghost">Text {SITE.phoneDisplay}</a>
    </div>
  </section>
</BaseLayout>
