---
/**
 * index.astro — the single page. Every "page" is an anchored <section>:
 * Hero (#hero), Services (#services), About (#about), Gallery (#gallery),
 * Reviews (#reviews), Contact (#contact). The header nav scroll-links to these.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Contact from "../components/Contact.astro";
import { SITE } from "../consts";
---

<BaseLayout
  title={`${SITE.name} — Mobile Auto Detailing in ${SITE.city}, ${SITE.state}`}
  description={SITE.description}
>
  <Hero />
  <Services />
  <About />
  <Gallery />
  <Reviews />
  <Contact />
</BaseLayout>
