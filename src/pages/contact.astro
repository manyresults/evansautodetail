---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { SITE } from "../consts";

const fullAddress = `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.state} ${SITE.address.zip}`;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(
  `${SITE.name} ${fullAddress}`,
)}&output=embed`;

/*
  CONTACT FORM SETUP
  ------------------
  This is a static site (no server), so the form needs a form-handling
  endpoint. Two easy, free options that work on SiteGround static hosting:
    • Formspree  → https://formspree.io  (create a form, paste its endpoint)
    • Web3Forms  → https://web3forms.com (create an access key)
  Replace FORM_ENDPOINT below with your Formspree endpoint (e.g.
  "https://formspree.io/f/xxxxxxx"). Until then the form posts nowhere;
  the phone/email links above always work as a fallback.
*/
const FORM_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID"; // TODO: replace
---

<BaseLayout
  title="Contact Us"
  description={`Contact Earl's Proper Detailing in ${SITE.address.city}, ${SITE.address.state}. Call ${SITE.phoneDisplay}, email ${SITE.email}, or send us a message to book your detail.`}
>
  <Hero
    eyebrow="Get in touch"
    title="Contact Earl's Proper Detailing"
    subtitle="Call, email, or send a message and we'll get right back to you. We'd love to make your vehicle shine."
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2">
      <!-- Contact details -->
      <div>
        <h2 class="text-2xl font-extrabold text-ink">Visit or call us</h2>
        <dl class="mt-6 space-y-6">
          <div class="flex gap-4">
            <dt class="sr-only">Address</dt>
            <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent" aria-hidden="true">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            </span>
            <dd>
              <p class="font-semibold text-ink">Our shop</p>
              <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="text-slate-600 hover:text-accent">
                {SITE.address.street}<br />
                {SITE.address.city}, {SITE.address.state} {SITE.address.zip}
              </a>
            </dd>
          </div>

          <div class="flex gap-4">
            <dt class="sr-only">Phone</dt>
            <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent" aria-hidden="true">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            </span>
            <dd>
              <p class="font-semibold text-ink">Call us</p>
              <a href={SITE.phoneHref} class="text-slate-600 hover:text-accent">{SITE.phoneDisplay}</a>
            </dd>
          </div>

          <div class="flex gap-4">
            <dt class="sr-only">Email</dt>
            <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent" aria-hidden="true">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            </span>
            <dd>
              <p class="font-semibold text-ink">Email us</p>
              <a href={`mailto:${SITE.email}`} class="break-all text-slate-600 hover:text-accent">{SITE.email}</a>
            </dd>
          </div>
        </dl>

        <!-- Hours -->
        <div class="mt-8">
          <h3 class="text-lg font-bold text-ink">Hours</h3>
          <table class="mt-3 w-full max-w-sm text-sm">
            <tbody>
              {
                SITE.hours.map((h) => (
                  <tr class="border-b border-slate-100 last:border-0">
                    <th scope="row" class="py-2 text-left font-medium text-slate-700">{h.day}</th>
                    <td class="py-2 text-right text-slate-600">
                      {h.open && h.close ? `${h.open} – ${h.close}` : "Closed"}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Contact form -->
      <div>
        <h2 class="text-2xl font-extrabold text-ink">Send us a message</h2>
        <form action={FORM_ENDPOINT} method="POST" class="mt-6 space-y-5">
          <!-- honeypot spam trap -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div>
            <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none"
            />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700">Phone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="vehicle" class="block text-sm font-medium text-slate-700">Vehicle (year / make / model)</label>
            <input
              id="vehicle"
              name="vehicle"
              type="text"
              class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-700">How can we help?</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-accent-600 sm:w-auto"
          >
            Send message
          </button>
          <p class="text-xs text-slate-500">
            Prefer to talk? Call us any time at
            <a href={SITE.phoneHref} class="font-semibold text-accent hover:text-accent-600">{SITE.phoneDisplay}</a>.
          </p>
        </form>
      </div>
    </div>

    <!-- Map -->
    <div class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
      <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
        <iframe
          title={`Map to ${SITE.name}`}
          src={mapEmbed}
          width="100%"
          height="360"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
